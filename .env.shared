# TARGET
DW_SITE=https://sites.google.com

# MODEL
EMBED_TEST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_TEST_MAX_SEQ=128
# 1 이면 HF 허브에 접속하지 않고 로컬 캐시만 쓴다. 캐시가 없으면 에러로 멈춘다.
# 받아두려면: uv run hf download <repo-id>
MODEL_LOCAL_ONLY=1

# PATH & FILE NAME
CORPORA_DUNGEONWORLD_PATH=corpora/dungeonworld/
URL_KEYWORD=/view/dwtemporary/
INDEX_FILE=index
META_FILE=meta
META_RESULT_FILE=diagnose
CHUNK_RESULT_FILE=chunks

# CRAWL CONFIG
DO_CRAWL=0
DO_CREATE=0
DO_DIAGNOSE=0
DO_MODEL_COMPARE=1
